# ==========================================
# DOCUMENT INTELLIGENCE RAG — CONFIGURATION
# ==========================================

# REQUIRED: Groq API key
# Get yours at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# OPTIONAL: Hugging Face token
# Get yours at https://huggingface.co/settings/tokens
HF_TOKEN=

# ==========================================
# AI MODELS
# ==========================================

# Language model for question answering
GROQ_MODEL=openai/gpt-oss-120b

# Language model for summarization
GROQ_MAP_MODEL=openai/gpt-oss-20b

# Local embedding model
RAG_EMBED_MODEL=BAAI/bge-base-en-v1.5

# Local reranking model
RAG_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2

# ==========================================
# HARDWARE
# ==========================================

# auto = automatic selection
# cuda = NVIDIA GPU
# cpu  = CPU only
RAG_DEVICE=auto

# ==========================================
# GROQ RATE LIMITS
# ==========================================

# Adjust according to your Groq account limits
GROQ_TPM=6000
GROQ_RPM=25

GROQ_MAX_RETRIES=3
GROQ_MAX_RETRY_AFTER=75

# ==========================================
# DOCUMENT PROCESSING
# ==========================================

RAG_CACHE_DIR=.rag_cache
RAG_PDF_BATCH_PAGES=24
RAG_SUMMARY_BATCH_CHARS=7000